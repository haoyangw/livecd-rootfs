#!/bin/bash
set -e

# Source important live-build config parameters
. /root/config/chroot

# Fix for 'apt install' not working on every reboot
echo "Updating APT cache..."
apt-get update

# Fix for Ethernet connection not working on first boot
echo "Installing and configuring netplan..."
apt-get install -y netplan.io
if [ "$LB_DISTRIBUTION" == "noble" ]; then
	# 'netplan-generator' and 'python3-netplan' are not published on Jammy
	apt-get install -y netplan-generator python3-netplan
fi

## Configure netplan to use NetworkManager backend(not systemd-networkd)
cat <<-'EOF' > /lib/netplan/00-network-manager-all.yaml
	network:
	  version: 2
	  renderer: NetworkManager
EOF

# Fix for desktop wallpaper being black on Ubuntu MATE 24.04
if [ "$LB_DISTRIBUTION" == "noble" ] && [ "$SUBPROJECT" == "desktop-preinstalled" ]; then
	# HACK: Install 'feh' that is used to set MATE wallpaper in my custom ubiquity
	# package
	apt-get install -y feh
	# Post-install hook for oem-config that removes 'feh'
	cat <<-'EON' > /usr/lib/oem-config/post-install/remove-feh
		#!/bin/sh
		apt-get -y remove --purge feh
	EON
	chmod a+x /usr/lib/oem-config/post-install/remove-feh
fi
