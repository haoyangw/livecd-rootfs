#!/bin/sh
set -e

# Fix for 'apt install' not working on every reboot
echo "Updating APT cache..."
apt-get update

# Fix for Ethernet connection not working on first boot
echo "Installing and configuring netplan..."
apt-get install -y netplan.io netplan-generator python3-netplan
## Configure netplan to use NetworkManager backend(not systemd-networkd)
cat <<-'EOF' > /lib/netplan/00-network-manager-all.yaml
	network:
	  version: 2
	  renderer: NetworkManager
EOF
